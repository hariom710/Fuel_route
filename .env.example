# Environment variables consumed by config/settings.py.
# Copy to `.env` and export in your shell/process manager as needed.
# None are required for local development — defaults shown below are used.

# --- Django -----------------------------------------------------------------
# Use a random secret in production; the default is for development only.
DJANGO_SECRET_KEY=change-me-to-a-random-string
# 1 = debug mode (never in production)
DJANGO_DEBUG=0

# --- Fuel Route Optimizer ---------------------------------------------------
# Fuel price CSV (the only source of fuel prices). Must contain the columns:
# OPIS Truckstop ID,Truckstop Name,Address,City,State,Rack ID,Retail Price
FUEL_CSV_PATH=fuel-prices-for-be-assessment.csv

# Approximate city-level coordinates (City+State -> lat/lon), generated from
# GeoNames by scripts/build_city_coordinates.py.
CITY_COORDS_PATH=data/city_coordinates.csv

# External services (both free, keyless).
OSRM_BASE_URL=https://router.project-osrm.org
PHOTON_BASE_URL=https://photon.komoot.io

# Perpendicular corridor (miles) within which stations count as "on route".
# 25 miles accommodates the city-level precision of GeoNames coordinates.
ROUTE_CORRIDOR_MILES=25
